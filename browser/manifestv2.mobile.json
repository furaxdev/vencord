{
    "manifest_version": 2,

    "name": "Vencord Mobile",
    "description": "The cutest Discord mod on your Android device",
    "author": "Vendicated",
    "homepage_url": "https://github.com/Vendicated/Vencord",
    "icons": {
        "128": "icon.png"
    },

    "permissions": [
        "webRequest",
        "webRequestBlocking",
        "*://*.discord.com/*",
        "https://raw.githubusercontent.com/*"
    ],

    "content_scripts": [
        {
            "run_at": "document_start",
            "matches": ["*://*.discord.com/*"],
            "js": ["content.js"],
            "all_frames": true,
            "world": "ISOLATED"
        },
        {
            "run_at": "document_start",
            "matches": ["*://*.discord.com/*"],
            "js": ["dist/Vencord.js"],
            "all_frames": true,
            "world": "MAIN"
        }
    ],

    "background": {
        "scripts": ["background.js"]
    },

    "web_accessible_resources": ["dist/Vencord.js", "dist/Vencord.css"],

    "browser_specific_settings": {
        "gecko": {
            "id": "vencord-mobile@vendicated.dev",
            "strict_min_version": "113.0"
        },
        "gecko_android": {
            "strict_min_version": "113.0"
        }
    }
}
